# Salin file ini menjadi .env.local untuk pengembangan lokal (vercel dev).
# Di Vercel, isi lewat Project → Settings → Environment Variables.

# gemini | groq
AI_PROVIDER=gemini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Kosongkan jika tidak ingin memakai kode akses
ACCESS_CODE=

# Maksimal request per IP per 10 menit
RATE_LIMIT=30

# Salin file ini menjadi .env.local untuk pengembangan lokal (vercel dev).
# Di Vercel, isi lewat Project → Settings → Environment Variables.

# gemini | groq
AI_PROVIDER=gemini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Password untuk membuka seluruh situs. Kosongkan agar situs terbuka.
SITE_PASSWORD=
# Lama login tersimpan, dalam hari
SESSION_DAYS=30

# Kode tambahan khusus fitur AI (opsional, tidak perlu jika SITE_PASSWORD diisi)
ACCESS_CODE=

# Maksimal request per IP per 10 menit
RATE_LIMIT=30
